# ─────────────────────────────────────────────────────────────────────
# Stripe Payment Links — primary donation processor.
# Setup:
#   1. Stripe Dashboard → Payment Links → Create
#   2. Choose "Customers choose what to pay"
#   3. Create two links: one-time + monthly (subscription)
#   4. Paste each https://buy.stripe.com/... URL below
#   5. Redeploy. Apple Pay / Google Pay show up automatically on Checkout.
# ─────────────────────────────────────────────────────────────────────
VITE_STRIPE_LINK_ONCE=
VITE_STRIPE_LINK_MONTHLY=

# Optional, only needed if you later build a server-side Checkout Session.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase (admin + dynamic content)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web3Forms (form submissions)
VITE_WEB3FORMS_KEY=

# GitHub Integration (optional)
GITHUB_TOKEN=

# Google Services (optional, used by GeminiAssistant if enabled)
GOOGLE_API_KEY=
