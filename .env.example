# ─────────────────────────────────────────────────────────────────────
# Stripe — embedded checkout (primary donation processor).
# The card form renders directly on /donate — no redirect to Stripe's
# site. Handles one-time AND monthly-subscription donations through the
# same panel. Powered by worker/index.ts (the Cloudflare Worker that
# serves this site) + src/components/EmbeddedDonateCheckout.tsx.
#
# Setup:
#   1. https://dashboard.stripe.com → Developers → API keys
#   2. Copy "Publishable key" (pk_...) and "Secret key" (sk_...)
#   3. VITE_STRIPE_PUBLISHABLE_KEY is public — set it in the Cloudflare
#      dashboard: Workers & Pages → funding-michigan-teachers → Settings
#      → Variables and Secrets → add as a plain "Variable" (or put it in
#      a local .env for `npm run build`, since Vite inlines it at build
#      time).
#   4. STRIPE_SECRET_KEY must stay a Worker SECRET, never a plain
#      variable: `npx wrangler secret put STRIPE_SECRET_KEY`, or
#      dashboard → same Settings page → add as "Secret". Never put it in
#      a committed file.
#   5. Redeploy. No Payment Link or Product/Price setup needed — the
#      amount is created dynamically from whatever the visitor picks.
#
# STRIPE_SECRET_KEY is used ONLY inside worker/index.ts (server-side).
# Never prefix it with VITE_ — that would ship it to every visitor's
# browser.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────
# Stripe Payment Links — fallback #1, used only if the embedded keys
# above aren't set. Opens buy.stripe.com in a new tab instead of staying
# on-page. Setup: Stripe Dashboard → Payment Links → Create → "Customers
# choose what to pay" → make one one-time link + one recurring link.
# ─────────────────────────────────────────────────────────────────────
VITE_STRIPE_LINK_ONCE=
VITE_STRIPE_LINK_MONTHLY=

# Supabase (admin + dynamic content)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web3Forms (form submissions)
VITE_WEB3FORMS_KEY=

# GitHub Integration (optional)
GITHUB_TOKEN=

# Google Services (optional, used by GeminiAssistant if enabled)
GOOGLE_API_KEY=
