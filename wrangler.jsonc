{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funding-michigan-teachers",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",

  // Keep variables set in the dashboard when this file is deployed. Without
  // it, a key added as a plain Variable instead of a Secret is deleted by
  // the next git deploy, and the CRM quietly stops receiving forms.
  "keep_vars": true,

  // Keep the Worker's logs, so a form that did not reach Bloomerang can be
  // looked up afterwards: Workers & Pages → funding-michigan-teachers →
  // Observability, search "[crm]". The reason is logged there, not sent to
  // the visitor.
  "observability": { "enabled": true },

  // ── There is deliberately no "vars" block ─────────────────────────────────
  //
  // This file is committed, so anything in "vars" is published to GitHub.
  // Every credential this Worker uses — STRIPE_SECRET_KEY, MERCH_CODES,
  // BLOCKED_IPS, BLOOMERANG_API_KEY — is set in the Cloudflare dashboard as a
  // Secret instead: encrypted at rest, never readable back, and never synced
  // into this file.
  //
  // Cloudflare offers to "keep deployments in sync" by pasting a value here
  // when something is added as a plain Variable rather than a Secret. Do not
  // accept it. The fix is to delete the Variable and re-add it under Secrets;
  // env.NAME reads identically either way, so no code changes.
  //
  // BLOOMERANG_API_KEY in particular can read and write the whole CRM —
  // donor names, addresses, giving history. It is not a publishable key like
  // the Stripe or Supabase ones that do live in this repo.
  // Bind the real domain to this Worker on deploy. If a deploy fails with
  // "hostname already associated" (or similar), the domain is still held by
  // the old static Pages project — remove it there and redeploy.
  "routes": [
    { "pattern": "fundingmichiganteachers.org", "custom_domain": true },
    { "pattern": "www.fundingmichiganteachers.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A miss is a miss. Under "single-page-application" the asset service
    // answered EVERY unmatched path with index.html at HTTP 200 — including
    // /assets/SomePage-<hash>.js from a build that no longer exists, which a
    // browser then refuses as a module ("Expected a JavaScript-or-Wasm module
    // script but the server responded with a MIME type of text/html"). The
    // lazy import rejected and the page sat on its blank Suspense fallback.
    //
    // The Worker serves the shell for real pages instead (see the tail of
    // worker/index.ts); the asset service now only ever serves files that are
    // actually there. These two must deploy together — "none" on its own
    // would 404 every page.
    "not_found_handling": "none",
    // Pages and API calls run the Worker first (IP blocking, real 404s,
    // canonical redirects). Hashed bundles and photos skip it — negative rules
    // route them straight to Cloudflare's asset service and edge cache, which
    // is faster and also preserves the deliberate behavior that blocked
    // visitors can still fetch the CSS/JS the /restricted page needs.
    // (With the old ["/api/*"] value page views never reached the Worker at
    // all, which is why IP blocking and 404s didn't work before.)
    // Fonts joined them when they moved off Google Fonts (October 2026).
    "run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/fonts/*"]
  }
}
