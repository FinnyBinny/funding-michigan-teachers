{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funding-michigan-teachers",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  // Bind the real domain to this Worker on deploy. If a deploy fails with
  // "hostname already associated" (or similar), the domain is still held by
  // the old static Pages project — remove it there and redeploy.
  "routes": [
    { "pattern": "fundingmichiganteachers.org", "custom_domain": true },
    { "pattern": "www.fundingmichiganteachers.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request runs the Worker first. With the previous ["/api/*"] value
    // only API calls reached worker/index.ts — page views were answered
    // straight from static assets, so the Worker could neither block an IP nor
    // return a real 404 (unknown paths got index.html at status 200). The
    // Worker now serves assets itself via env.ASSETS.fetch().
    "run_worker_first": true
  }
}
